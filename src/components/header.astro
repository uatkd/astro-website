---
import logo from "../assets/logo.png"
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="#" class="font-bold text-xl text-amber-400">
        <img src={logo.src} alt="UAlberta Taekwondo Club" class="h-16 w-auto"/>
      </a>
      <nav class="flex items-center gap-8">
        <a href="#about" class="text-sm font-medium text-gray-600 hover:text-amber-400 transition-colors">About</a>
        <a href="#whatistkd" class="text-sm font-medium text-gray-600 hover:text-amber-400 transition-colors">Taekwondo</a>
        <a href="#join" class="text-sm font-medium text-gray-600 hover:text-amber-400 transition-colors">Join</a>
        <a href="#faq" class="text-sm font-medium text-gray-600 hover:text-amber-400 transition-colors">FAQ</a>
      </nav>
    </div>
  </div>
</header>