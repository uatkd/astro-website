---
// https://tailwindflex.com/@ron-hicks/steps-block

import Step1 from "../content/steps/step1.md"
import Step2 from "../content/steps/step2.md"
import Step3 from "../content/steps/step3.md"
---

<section id="join" class="py-16 sm:py-24">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h3 class="mt-2 text-3xl sm:text-5xl leading-normal font-extrabold tracking-tight text-gray-900">
        How to <span class="text-amber-400">join the club?</span>
      </h3>
    </div>

    <div class="mt-20 pt-8">
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <li class="bg-gray-100 p-5 pb-10 text-center mt-10">
          <div class="flex flex-col items-center">
            <div class="shrink-0 -mt-16">
              <div class="flex items-center justify-center h-20 w-20 rounded-full bg-amber-400 text-white border-4 border-white text-xl font-semibold">
                1
              </div>
            </div>
            <div class="mt-4">
              <h4 class="text-lg leading-6 font-semibold text-gray-900">Pay the club fees</h4>
              <div class="mt-2 text-base leading-6 text-gray-500">
                <Step1/>
              </div>
            </div>
          </div>
        </li>
        <li class="bg-gray-100 p-5 pb-10 text-center mt-10">
          <div class="flex flex-col items-center">
            <div class="shrink-0 -mt-16">
              <div class="flex items-center justify-center h-20 w-20 rounded-full bg-amber-400 text-white border-4 border-white text-xl font-semibold">
                2
              </div>
            </div>
            <div class="mt-4">
              <h4 class="text-lg leading-6 font-semibold text-gray-900">Connect with the club</h4>
              <div class="mt-2 text-base leading-6 text-gray-500">
                <Step2/>
              </div>
            </div>
          </div>
        </li>
        <li class="bg-gray-100 p-5 pb-10 text-center mt-10">
          <div class="flex flex-col items-center">
            <div class="shrink-0 -mt-16">
              <div class="flex items-center justify-center h-20 w-20 rounded-full bg-amber-400 text-white border-4 border-white text-xl font-semibold">
                3
              </div>
            </div>
            <div class="mt-4">
              <h4 class="text-lg leading-6 font-semibold text-gray-900">Welcome to the club</h4>
              <div class="mt-2 text-base leading-6 text-gray-500">
                <Step3/>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>