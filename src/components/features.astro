---
import Beginners from "../content/features/beginnerswelcome.md"
import Events from "../content/features/socialevents.md"
import Fees from "../content/features/lowestfees.md"
---
<div class="bg-white grid grid-cols-4 gap-6 px-8 py-4 items-start">

  <!-- Column 1 -->
  <div class="flex flex-col gap-6 mt-8">
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-72">
      <h3 class="text-orange-500 font-bold text-4xl tracking-tight mb-4">Beginners welcome</h3>
      <div class="text-gray-600 text-base"><Beginners/></div>
    </div>
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-56">
      <h3 class="text-amber-400 font-bold text-4xl tracking-tight">Kicks</h3>
    </div>
  </div>

  <!-- Column 2 -->
  <div class="flex flex-col gap-6 mt-20">
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-72">
      <h3 class="text-pink-400 font-bold text-4xl tracking-tight mb-4">Social events</h3>
      <div class="text-gray-600 text-base"><Events/></div>
    </div>
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-56">
      <h3 class="text-pink-400 font-bold text-4xl tracking-tight">Sparring</h3>
    </div>
  </div>

  <!-- Column 3 -->
  <div class="flex flex-col gap-6 mt-12">
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-72">
      <h3 class="text-purple-400 font-bold text-4xl tracking-tight mb-4">Lowest fees</h3>
      <div class="text-gray-600 text-base"><Fees/></div>
    </div>
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-56">
      <h3 class="text-purple-400 font-bold text-4xl tracking-tight">Strength</h3>
    </div>
  </div>

  <!-- Column 4 -->
  <div class="flex flex-col gap-6 mt-28">
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-72">
      <h3 class="text-amber-400 font-bold text-4xl tracking-tight leading-tight">
        Student led<br/>Student delivered<br/>Student focused
      </h3>
    </div>
    <div class="text-center p-8 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-center min-h-56">
      <h3 class="text-orange-500 font-bold text-4xl tracking-tight">Flexibility</h3>
    </div>
  </div>

</div>