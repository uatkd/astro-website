---
import TKD from "../content/whatistkd/tkd.md"
import Carousel from "../components/carousel.astro";
import img1 from "../assets/img1.jpg";
import img2 from "../assets/img2.jpg";
import img3 from "../assets/img3.jpg";
---
<section id="whatistkd" class="bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 text-left">
        <h2 class="text-5xl font-semibold tracking-tight text-balance">
          What is <span class="text-amber-400">Taekwondo?</span>
        </h2>
        <div class="mt-6 text-lg text-gray-600">
          <TKD/>
        </div>
      </div>
      <div class="flex-1 w-full">
        <Carousel images={[img1, img2, img3]}/>
      </div>
    </div>
  </div>
</section>