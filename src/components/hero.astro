---
import About from "../content/hero/about.md"
import Carousel from "../components/carousel.astro";
import { Icon } from 'astro-icon/components';
import img1 from "../assets/img1.jpg";
import img2 from "../assets/img2.jpg";
import img3 from "../assets/img3.jpg";
---
<section id="about" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
  <div class="flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 text-left">
      <h1 class="text-5xl font-semibold tracking-tight text-balance sm:text-7xl">
        UAlberta <span class="text-amber-400">Taekwondo Club</span>
      </h1>
      <div class="mt-6 text-lg text-gray-600">
        <About/>
      </div>
      <div class="flex items-center gap-5 mt-6">
        <a href="mailto:crtkd@ualberta.ca" target="_blank" class="text-gray-400 hover:text-amber-400 transition-colors">
          <Icon name="email" class="w-8 h-8" />
        </a>
        <a href="https://www.instagram.com/ua_taekwondo" target="_blank" class="text-gray-400 hover:text-amber-400 transition-colors">
          <Icon name="instagram" class="w-8 h-8" />
        </a>
        <a href="https://www.youtube.com/channel/UCaJgSN-AD2eBfanJSVejUGg" target="_blank" class="text-gray-400 hover:text-amber-400 transition-colors">
          <Icon name="youtube" class="w-8 h-8" />
        </a>
        <a href="https://discord.gg/z3atcrMWGX" target="_blank" class="text-gray-400 hover:text-amber-400 transition-colors">
          <Icon name="discord" class="w-8 h-8" />
        </a>
        <a href="https://linktr.ee/ua_tkd" target="_blank" class="text-gray-400 hover:text-amber-400 transition-colors">
          <Icon name="linktree" class="w-8 h-8" />
        </a>
      </div>
    </div>
    <div class="flex-1 w-full">
      <Carousel images={[img1, img2, img3]}/>
    </div>
  </div>
</section>